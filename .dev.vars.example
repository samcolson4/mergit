# Copy to .dev.vars to run `npm run dev` against a real GitHub App.
# Never commit .dev.vars. (No App? Use `npm run dev:fake-github`.)
#
# From the App's settings page (README → "Register the GitHub App"):
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-mergit-app
GITHUB_CLIENT_ID=Iv23li...
GITHUB_CLIENT_SECRET=...
# The private key: paste the PEM base64-encoded on one line, e.g.
#   base64 < your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=LS0tLS1CRUdJTi...
