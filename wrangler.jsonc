{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mergit",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true // so every response gets the security headers
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "Board" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // GitHub App: see README → "Hosting". Secrets (wrangler secret put …):
  // GITHUB_CLIENT_SECRET, GITHUB_APP_PRIVATE_KEY. Plain settings below.
  "vars": {
    "GITHUB_APP_ID": "",
    "GITHUB_APP_SLUG": "",
    "GITHUB_CLIENT_ID": ""
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board", "Directory"] }],
  // Rebuild the browser bundle whenever client code changes during `wrangler dev`.
  "build": { "command": "npm run build:web", "watch_dir": ["client", "worker"] }
}
